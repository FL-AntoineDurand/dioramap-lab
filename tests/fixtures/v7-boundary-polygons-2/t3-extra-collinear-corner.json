{
  "id":          "t3-extra-collinear-corner",
  "category":    "smoke",
  "description": "T1 + extra 5th corner at top-edge midpoint (5,10). Since this step does no deletion, the result should be a 5-vertex polygon (the extra corner appears between corners 2 and 3 in CCW order). Regularization downstream removes the flat vertex.",
  "inputs": {
    "plane_basis": { "e1": [1,0,0], "e2": [0,1,0], "normal": [0,0,1] },
    "anchors": [
      { "id": 0, "x":  0.0, "y":  0.0, "z": 0.0, "source": "concave" },
      { "id": 1, "x": 10.0, "y":  0.0, "z": 0.0, "source": "concave" },
      { "id": 2, "x": 10.0, "y": 10.0, "z": 0.0, "source": "concave" },
      { "id": 4, "x":  5.0, "y": 10.0, "z": 0.0, "source": "concave" },
      { "id": 3, "x":  0.0, "y": 10.0, "z": 0.0, "source": "concave" }
    ],
    "group_pts":  { "generator": "synth_cloud_inside",  "params": { "density": 4.0 } },
    "nearby_pts": { "generator": "synth_cloud_outside", "params": { "offset": 0.5, "per_edge": 5 } },
    "contours": [
      {
        "is_hole": false,
        "polyU": [0.0, 10.0, 10.0, 5.0, 0.0],
        "polyV": [0.0, 0.0,  10.0, 10.0, 10.0]
      }
    ]
  },
  "expected": {
    "polygons": [ { "corner_ids": [0, 1, 2, 4, 3], "kind": "outer" } ],
    "max_wsd_m": 0.001
  }
}
