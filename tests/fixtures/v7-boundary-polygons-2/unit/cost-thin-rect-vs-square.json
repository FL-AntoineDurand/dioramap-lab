      { "id": 1, "x": 8.0, "y": 0.0, "z": 0.0, "source": "concave" },
      { "id": 2, "x": 8.0, "y": 1.0, "z": 0.0, "source": "concave" },
      { "id": 3, "x": 0.0, "y": 1.0, "z": 0.0, "source": "concave" }
    ],
    "cycle_a": [0, 1, 2, 3],
    "anchors_b": [
      { "id": 0, "x": 0.0, "y": 0.0, "z": 0.0, "source": "concave" },
